<Application x:Class="PdfTitleRenamer.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0031D8"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#00118F"/>
        <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#595959"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#949494"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#D5D9E0"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#E8F1FE"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
        <SolidColorBrush x:Key="WarningTextBrush" Color="#7A4E00"/>
        <Style x:Key="VisibleFocus" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate>
                <Border BorderBrush="#FFEF00" BorderThickness="3" Margin="-5"><Border BorderBrush="Black" BorderThickness="2"/></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Yu Gothic UI"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E8F1FE"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#D2E1FF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#666666"/><Setter TargetName="ButtonBorder" Property="Background" Value="#EBEBEB"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#949494"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#000071"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#666666"/><Setter TargetName="ButtonBorder" Property="Background" Value="#EBEBEB"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#949494"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocus}"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="Black"/><Setter Property="Background" Value="#FFFDE5"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocus}"/><Setter Property="MinHeight" Value="28"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocus}"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F1F1F1"/><Setter Property="Foreground" Value="#1A1A1A"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
        <Style x:Key="StepNumberStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="StepNumberTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Pill used for statuses. Set Tag to Success / Warning / Danger / Info; anything else is neutral. -->
        <Style x:Key="ToneChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="10,2"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/>
            <Setter Property="Background" Value="#F1F1F1"/><Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="TextElement.Foreground" Value="#4D4D4D"/><Setter Property="TextElement.FontSize" Value="12.5"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Success"><Setter Property="Background" Value="#E6F4EE"/><Setter Property="BorderBrush" Value="#9FD3BC"/><Setter Property="TextElement.Foreground" Value="#0F5A41"/></Trigger>
                <Trigger Property="Tag" Value="Warning"><Setter Property="Background" Value="#FFF4D6"/><Setter Property="BorderBrush" Value="#EDC461"/><Setter Property="TextElement.Foreground" Value="#7A4E00"/></Trigger>
                <Trigger Property="Tag" Value="Danger"><Setter Property="Background" Value="#FCE8E6"/><Setter Property="BorderBrush" Value="#F1AEA8"/><Setter Property="TextElement.Foreground" Value="#9B1C13"/></Trigger>
                <Trigger Property="Tag" Value="Info"><Setter Property="Background" Value="#E8F1FE"/><Setter Property="BorderBrush" Value="#A9C4F5"/><Setter Property="TextElement.Foreground" Value="#0031D8"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Keep row text readable when selected instead of the default white-on-blue. -->
        <Style x:Key="ReadableCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
