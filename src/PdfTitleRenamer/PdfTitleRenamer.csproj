<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PdfTitleRenamer_AI</AssemblyName>
    <RootNamespace>PdfTitleRenamer</RootNamespace>
    <AssemblyTitle>PDF Title to Filename AI</AssemblyTitle>
    <Company>fa-yoshinobu</Company>
    <Copyright>Copyright © 2026 fa-yoshinobu</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icons\app.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <Product>PDFタイトル一括リネーム AI版</Product>
    <Description>PDF Title to FilenameのAI版。Windows OCRとCodexでPDFのタイトルを推定し、安全に一括リネームします。</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Icons\app.ico" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="PdfTitleRenamer.LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="PdfTitleRenamer.THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="..\..\ThirdPartyLicenses\**\*" LogicalName="PdfTitleRenamer.ThirdPartyLicenses/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.14" />
    <FrameworkReference Update="Microsoft.WindowsDesktop.App.WPF" RuntimeFrameworkVersion="10.0.14" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <!-- Pin the native Windows renderer as well as its managed wrapper. -->
    <PackageReference Include="SkiaSharp" Version="4.155.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.155.0" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="159.0.8138" />
    <!-- Align transitive native assets with the managed renderer on every platform. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.155.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.155.0" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="159.0.8138" />
    <PackageReference Include="bblanchon.PDFium.macOS" Version="159.0.8138" />
  </ItemGroup>
  <Target Name="RemoveNativeDebugSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
