<Window x:Class="PdfTitleRenamer.RenamePreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="変更内容の確認" Width="960" Height="620" MinWidth="720" MinHeight="440" WindowStartupLocation="CenterOwner" FontFamily="Yu Gothic UI" FontSize="14"
        Foreground="{StaticResource InkBrush}" Background="{StaticResource PageBrush}" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ファイル名を変更する前に" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,14">
            <Border x:Name="ReviewBanner" Style="{StaticResource ToneChipStyle}" Tag="Info" CornerRadius="6" Padding="12,8" Margin="0" HorizontalAlignment="Stretch">
                <TextBlock x:Name="ReviewText" TextWrapping="Wrap" FontSize="13.5"/>
            </Border>
            <TextBlock Text="同名を避ける連番・使えない文字の補正を反映した、実際の変更名です。PDFの内容は変更しません。" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
        </StackPanel>
        <DataGrid x:Name="PreviewGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  MinRowHeight="44" ColumnHeaderHeight="42" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3E6EA" Background="White"
                  BorderBrush="{StaticResource CardBorderBrush}" AlternatingRowBackground="#FAFBFC" CellStyle="{StaticResource ReadableCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="現在のファイル名" Binding="{Binding CurrentName}" Width="1*">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="" Width="28">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="&#x2192;" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="変更後のファイル名（確定）" Binding="{Binding TargetName}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="確認事項" Width="180" SortMemberPath="Note">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ToneChipStyle}" Tag="{Binding NoteTone}"><TextBlock Text="{Binding Note}"/></Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="戻って編集" IsCancel="True" Margin="0,0,12,0"/>
            <Button x:Name="ExecuteButton" Content="ファイル名を変更" Style="{StaticResource PrimaryButton}" Click="ExecuteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
